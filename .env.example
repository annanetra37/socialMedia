# ─── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Meta App (shared across all brands) ──────────────────────
# Per-brand tokens are set automatically via OAuth — no manual token needed.
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# ─── Trend Data (RapidAPI: instagram-scraper-20251) ───────────
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── Database ─────────────────────────────────────────────────
# Railway Postgres plugin sets this automatically. For local dev, omit to use JSON files.
# DATABASE_URL=postgresql://user:pass@localhost:5432/socialmedia

# ─── App Settings ─────────────────────────────────────────────
RUN_MODE=demo    # "demo" = no real API calls | "live" = full live mode
TIMEZONE=UTC
