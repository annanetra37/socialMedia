# ─── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Meta / Instagram Graph API ───────────────────────────────
META_ACCESS_TOKEN=your_meta_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# ─── Image Generation (optional) ──────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here        # for DALL-E image generation
STABILITY_API_KEY=your_stability_api_key_here  # for Stable Diffusion

# ─── Trend Data Sources ───────────────────────────────────────
# API: instagram-scraper-20251 by DavidGelling on RapidAPI
# Used for: real hashtag post counts, competitor recent posts
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── App Settings ─────────────────────────────────────────────
# RUN_MODE: "demo" (mock data, free) | "live" (real APIs)
RUN_MODE=demo
LOG_LEVEL=INFO
TIMEZONE=UTC
